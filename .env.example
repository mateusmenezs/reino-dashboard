# ─────────────────────────────────────────────────────────────────────────────
# Construtor de Mentoria com IA — variáveis de ambiente
#
# COMO USAR
#   1. Copie este arquivo:      cp .env.example .env.local
#   2. Preencha os valores.
#   3. Reinicie o `npm run dev` (o Vite só lê .env na inicialização).
#   Na Vercel: Project → Settings → Environment Variables → e FAÇA REDEPLOY.
#   Variável VITE_ nova sem redeploy NÃO entra no bundle. Ver docs/WEBHOOK_N8N.md §2.
#
# ⚠️  AVISO — TUDO QUE COMEÇA COM `VITE_` É PÚBLICO
#   O Vite substitui essas variáveis pelo VALOR LITERAL dentro do JavaScript que
#   vai para o navegador. Qualquer participante consegue lê-las no DevTools.
#   NUNCA coloque aqui: chave da Evolution API / WhatsApp, chave de OpenAI /
#   Anthropic / Gemini, senha de banco, token de CRM. Essas credenciais ficam
#   guardadas DENTRO do n8n, que roda no servidor.
#
# .env e .env.local já estão no .gitignore. Este .env.example é o único que
# deve ser commitado — e ele nunca leva valor real.
# ─────────────────────────────────────────────────────────────────────────────


# URL de produção do Webhook node do n8n. OBRIGATÓRIA para o envio funcionar.
# Sem ela o app mostra "Envio ainda não liberado" e guarda as respostas localmente.
# Pegue em: n8n → seu workflow → Webhook node → aba "Production URL".
# NÃO use a "Test URL": ela só aceita UMA chamada e depois responde 404.
# Exemplo (substitua pelo seu domínio real):
VITE_N8N_WEBHOOK_URL=https://SEU-N8N.exemplo.com/webhook/construtor-mentoria


# OPCIONAL. Se preenchida, o app envia `Authorization: Bearer <valor>` e o n8n
# pode recusar quem não mandar o token — filtra robô e chamada aleatória.
# Não é segurança forte (o valor vai no bundle e é legível no navegador);
# é um porteiro descartável. Gere um valor aleatório e troque depois do evento.
# Deixe VAZIA para não enviar nenhum header de autenticação.
VITE_N8N_WEBHOOK_TOKEN=


# OPCIONAL. Tempo máximo, em milissegundos, esperando o n8n confirmar o
# recebimento. Padrão 15000 (15s). Só aumente se o seu n8n responder devagar —
# o certo é configurar o Webhook node em "Respond immediately", e aí 15s sobra.
VITE_N8N_TIMEOUT_MS=15000


# OPCIONAL. "true" liga o modo evento (a turma caminha junto, conduzida do
# palco). Hoje apenas expõe o valor para a UI — não bloqueia nenhuma etapa.
# Qualquer outro valor, ou vazio, = modo livre.
VITE_EVENT_MODE=false


# OPCIONAL. Etapa (1..6) que o evento está percorrendo agora, para uso futuro
# junto com VITE_EVENT_MODE. 0 ou vazio = livre, o participante anda sozinho.
VITE_CURRENT_EVENT_STEP=0
